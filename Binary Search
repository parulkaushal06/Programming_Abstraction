Occurence of target
import java.util.*;
class Main {
    public static void main(String[] args) {
        int [] arr = {1,2,2,2,3};
        int target = 2;
        int low = 0;
        int high = arr.length ;
        int ans = -1;
        while(low < high){
            int mid = low +((high-low)/2);
            if(arr[mid]==target){
                ans = mid ;
                high = mid -1;
            }
            else if(arr[mid]>=target){
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }
        System.out.println(ans);
    }
}
