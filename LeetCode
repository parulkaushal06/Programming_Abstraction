class Solution {
    public void swap(String[] names, int i, int j){
        String temp = names[i];
        names[i] = names[j];
        names[j] = temp ;
    }
    public void swap(int[] heights, int i, int j){
        int temp = heights[i];
        heights[i] = heights[j];
        heights[j] = temp ;
    }
    public String[] sortPeople(String[] names, int[] heights) {
        for(int k =0; k<heights.length; k++){
            int max = Integer.MIN_VALUE;
            int max_idx = 0;
            for(int i=k; i<heights.length; i++){
            if(heights[i]>max){
                max = heights[i];
                max_idx = i;
                swap(names, k, max_idx);
                swap(heights, k, max_idx);
            }   
        }
        }
        return names ;
    }
}
