class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int s = 0;
        int e = n-1;
        while(s<=e){
            int m = s + ((e-s)/2);
            if(nums[m]==target){
                return m ;
            }
            else if(nums[s]<=nums[m]){
                if(nums[s]<= target && target< nums[m]){
                    e = m-1;
                }
                else {
                    s = m+1;
                }
            }
            else if(nums[m]<=nums[e]){
                if(nums[m]< target && target<= nums[e]){
                    s = m+1;
                }
                else {
                    e = m-1;
                }
            }
        }
        return -1;
    }
}

