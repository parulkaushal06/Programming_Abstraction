Reverse of a linked list :
class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode curr = head ;
        ListNode prev = null ;
        while(curr != null){
            ListNode nextnode = curr.next ;
            curr.next = prev ;
            prev = curr ;
            curr = nextnode ;
        }
        return prev ;
    }
}

